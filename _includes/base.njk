<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Courier+Prime:wght@400;700&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/gute.css">
    {% block styles %}{% endblock %}
</head>
<body>

<!-- NAV -->
<nav>
    <a href="/" class="nav-logo" id="navLogo">G<span class="nav-umlaut">Ü</span>TE</a>
    <div class="nav-links">
        <a href="/story.html" class="nav-link{% if activePage == 'story' %} active{% endif %}" id="navLink1">Our Story</a>
        <a href="/ingredients.html" class="nav-link{% if activePage == 'ingredients' %} active{% endif %}" id="navLink2">Ingredients</a>
        <a href="/#reserve" class="nav-cta" id="navCta">Reserve Yours →</a>
    </div>
</nav>

{% block content %}{% endblock %}

<!-- FOOTER -->
<footer>
    <div>
        <div class="footer-logo">G<span class="footer-umlaut">Ü</span>TE</div>
        <div class="footer-tagline">Good food. No filler.</div>
    </div>
    <div class="footer-right">
        <div class="footer-domain">gutefoodco.com</div>
        <div class="footer-copy">© 2026 GUTE FOOD CO. — All rights reserved.</div>
    </div>
</footer>

<script src="/js/gute.js"></script>
</body>
</html>
