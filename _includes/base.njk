<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description or 'GÜTE Crunch is a functional dark-chocolate snack bar with 10g fiber, 6g plant protein, seven ancient grains and seeds, and real fruit. Gut-friendly, gluten-free, and vegan.' }}">
    <link rel="canonical" href="https://thegutecompany.com{{ page.url }}">
    <meta name="robots" content="index, follow">
    <meta name="theme-color" content="#2C1208">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="GÜTE">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description or 'GÜTE Crunch — a gut-friendly dark-chocolate snack bar. 10g fiber, 6g plant protein, real fruit.' }}">
    <meta property="og:url" content="https://thegutecompany.com{{ page.url }}">
    <meta property="og:image" content="https://thegutecompany.com/images/gute-og.jpg">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ description or 'GÜTE Crunch — a gut-friendly dark-chocolate snack bar. 10g fiber, 6g plant protein, real fruit.' }}">
    <meta name="twitter:image" content="https://thegutecompany.com/images/gute-og.jpg">

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Courier+Prime:wght@400;700&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/gute.css">

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "GÜTE",
      "legalName": "The Gute Company",
      "url": "https://thegutecompany.com",
      "logo": "https://thegutecompany.com/images/gute-og.jpg",
      "description": "Maker of GÜTE Crunch — a functional dark-chocolate snack bar built for gut health.",
      "slogan": "Good food. No filler."
    }
    </script>

    {% block styles %}{% endblock %}
</head>
<body>

<!-- NAV -->
<nav>
    <a href="/" class="nav-logo" id="navLogo">G<span class="nav-umlaut">Ü</span>TE</a>
    <div class="nav-links">
        <a href="/story.html" class="nav-link{% if activePage == 'story' %} active{% endif %}" id="navLink1">Our Story</a>
        <a href="/ingredients.html" class="nav-link{% if activePage == 'ingredients' %} active{% endif %}" id="navLink2">Ingredients</a>
        <a href="/function.html" class="nav-link{% if activePage == 'function' %} active{% endif %}" id="navLink3">Function</a>
        <a href="/#reserve" class="nav-cta" id="navCta">Reserve Yours →</a>
    </div>
</nav>

{% block content %}{% endblock %}

<!-- FOOTER -->
<footer>
    <div>
        <div class="footer-logo">G<span class="footer-umlaut">Ü</span>TE</div>
        <div class="footer-tagline">Good food. No filler.</div>
    </div>
    <div class="footer-right">
        <div class="footer-domain">thegutecompany.com</div>
        <div class="footer-copy">© 2026 The Gute Company, DBA Gute Foods — All rights reserved.</div>
    </div>
</footer>

<script src="/js/gute.js"></script>
</body>
</html>
