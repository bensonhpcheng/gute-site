<script>
    document.querySelectorAll('[data-ing]').forEach(card => {
        const header = card.querySelector('.ing-header');
        const expand = card.querySelector('.ing-expand');
        const fit = () => { if (card.classList.contains('open')) expand.style.maxHeight = expand.scrollHeight + 'px'; };
        header.addEventListener('click', () => {
            const isOpen = card.classList.toggle('open');
            expand.style.maxHeight = isOpen ? expand.scrollHeight + 'px' : null;
        });
        window.addEventListener('resize', fit, { passive: true });
    });
</script>
